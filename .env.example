# ========================================
# Nova Environment Variables
# ========================================
# Copy this file to .env and fill in your actual values

# OpenAI Configuration
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4

# Google Trends (optional for MVP)
GOOGLE_TRENDS_ENABLED=false

# Database (for future use)
DATABASE_URL=postgresql://localhost:5432/nova

# Redis Cache (for future use)
REDIS_URL=redis://localhost:6379

# Java Backend URL (if using microservices)
JAVA_BACKEND_URL=http://localhost:8080

# Other Services
# Add other API keys and secrets as needed
